# SAARTHI .env.example — copy to .env and adjust as needed.
# Never commit your real .env. The defaults here are no-secret local-dev values.
#
# Configuration rules (Design v2 Section 7.4):
#   - Required settings have safe local defaults; nothing is required to run
#     the offline learning loop.
#   - Optional provider credentials (HF_TOKEN, LLM_API_KEY) are validated at
#     startup WITHOUT printing them; missing credentials produce
#     understandable diagnostics and never break offline lessons,
#     assessments or local decision-making.

# ---- App ----
APP_NAME=SAARTHI
APP_VERSION=0.1.0
ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ---- Network ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
# CORS allow-list (comma-separated). ENV=prod REQUIRES an explicit list —
# a wildcard is rejected at startup.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Persistence (default: SQLite file, no extra service required) ----
PERSISTENCE_BACKEND=sqlite
DATABASE_URL=sqlite+aiosqlite:///./saarthi.db
# For PostgreSQL:
# PERSISTENCE_BACKEND=postgres
# DATABASE_URL=postgresql+asyncpg://saarthi:saarthi@localhost:5432/saarthi
DB_POOL_SIZE=5
DB_ECHO=false

# ---- Object storage (default: local filesystem) ----
OBJECT_STORAGE_BACKEND=local
PACKS_DIR=packs

# ---- Ruleset (the SHARED decision ruleset — both engines read this) ----
SAARTHI_RULESET_PATH=packages/ruleset/rules.json

# ---- Translation (default: mock — returns a typed UNAVAILABLE error) ----
# IndicTrans2 (Hugging Face, gated repos). The offline learning path NEVER
# needs these credentials.
#   1. Accept the gated repo conditions on:
#      https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
#      https://huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M
#   2. Set TRANSLATION_PROVIDER=hf_local
#   3. Set HF_TOKEN (https://huggingface.co/settings/tokens)
TRANSLATION_PROVIDER=mock
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
HF_TRANSLATION_MODEL_EN2INDIC=ai4bharat/indictrans2-en-indic-dist-200M
HF_TRANSLATION_MODEL_INDIC2EN=ai4bharat/indictrans2-indic-en-dist-200M
TRANSLATION_CACHE_TTL_SECONDS=86400
# IndicTrans2 runtime (v2: all of it configurable)
HF_DEVICE=auto            # auto | cpu | cuda
HF_PRECISION=auto         # auto (fp16 on cuda, fp32 on cpu) | fp16 | fp32
HF_CACHE_DIR=             # defaults to HF_HOME / ~/.cache/huggingface
HF_TIMEOUT_SECONDS=120

# ---- LLM generation (default: mock — extractive fallback) ----
# To use an OpenAI-compatible chat completion endpoint:
#   1. Set LLM_PROVIDER=openai
#   2. Set LLM_API_KEY=sk-...
#   3. Adjust LLM_MODEL and optionally LLM_BASE_URL
LLM_PROVIDER=mock
# LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=12

# ---- Retrieval / embeddings (default: local_hybrid + mock embeddings) ----
RETRIEVAL_PROVIDER=local_hybrid
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Auth (device-bound; lifetimes come from the shared ruleset) ----
# rules.json `auth`: access_ttl_h=24 (short-lived access tokens),
# refresh_ttl_d=30 (rotating refresh tokens). Device keys are
# non-extractable WebCrypto ECDSA P-256 pairs generated on the phone.
DEVICE_TOKEN_BYTES=32
PIN_HASH_ITERATIONS=150000
MAX_PROFILES_PER_DEVICE=8

# ---- Rate limits / security ----
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=262144
ENABLE_SECURE_COOKIES=false   # set true behind TLS (required for prod)

# ---- Feature flags ----
ENABLE_PREFETCH=true
ENABLE_VOICE_ASR=false
ENABLE_VOICE_TTS=false
ENABLE_DEV_TRACE=true

# ---- Determinism / tests ----
RANDOM_SEED=42

# ---- Frontend (Vite reads VITE_*) ----
# The API base URL is baked into the build from this variable. The
# localhost fallback exists ONLY in dev builds — production builds REQUIRE
# VITE_API_URL (dev.py check scans the assets to enforce this).
VITE_API_URL=http://127.0.0.1:8000
