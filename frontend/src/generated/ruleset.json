{
  "version": "1.0.0",
  "ruleset_version": "1.0.0",
  "bkt_version": "1",
  "language": "or",
  "bkt": {
    "p_init_bp": 2000,
    "learn": 0.15,
    "slip": 0.10,
    "guess": 0.20,
    "clamp_bp": [100, 9900],
    "rounding": "half_up",
    "per_concept_overrides": {}
  },
  "bands": {
    "weak_below_bp": 4000,
    "mastered_at_bp": 8500
  },
  "guard": {
    "attempts_without_gain": 3,
    "min_gain_bp": 200
  },
  "network": {
    "online": { "rtt_ms_max": 800, "downlink_kbps_min": 400 },
    "weak": { "rtt_ms_max": 3000, "downlink_kbps_min": 50 },
    "probe_interval_s": 30,
    "probe_timeout_s": 3,
    "hysteresis_downgrade_after_bad": 1,
    "hysteresis_upgrade_after_good": 2
  },
  "delivery": {
    "online": "rich",
    "weak": "cached",
    "offline": "cached",
    "reconnected": "rich"
  },
  "background_actions": {
    "online": ["SYNC", "PREFETCH"],
    "weak": ["SYNC"],
    "offline": [],
    "reconnected": ["SYNC", "PREFETCH"]
  },
  "prefetch": { "min_free_mb": 150, "battery_saver_blocks": true },
  "sync": {
    "batch_size": 100,
    "backoff_s": [5, 15, 60, 300],
    "backoff_jitter": 0.2,
    "max_inflight_batches": 1
  },
  "doubt": { "max_tool_calls": 3, "budget_s": 12, "top_k": 4 },
  "auth": { "access_ttl_h": 24, "refresh_ttl_d": 30, "challenge_ttl_s": 300 },
  "repetition_guard": {
    "attempts_without_gain": 3,
    "min_gain_bp": 200
  },
  "target_selection": {
    "strategy": "last_graded_then_doubt_hint_then_lowest_mastered_prereqs",
    "prerequisite_required": true,
    "tiebreak": "chapter_order_then_concept_id"
  },
  "mastery": {
    "thresholds": {
      "weak_below_bp": 4000,
      "mastered_at_bp": 8500
    },
    "bands": ["weak", "partial", "mastered"]
  },
  "retries": {
    "default_max_attempts": 3,
    "default_timeout_ms": 8000,
    "backoff_initial_ms": 500,
    "backoff_max_ms": 8000,
    "backoff_jitter": 0.25
  },
  "pack": {
    "max_bytes": 5242880,
    "min_app_version": "0.1.0",
    "checksum_algorithm": "sha256",
    "stale_after_days": 180
  },
  "orchestration": {
    "max_tool_calls_per_turn": 3,
    "max_total_time_ms": 12000,
    "max_retries_per_tool": 1,
    "allowed_tools": [
      "translate_text",
      "retrieve_chunks",
      "generate_answer",
      "validate_answer",
      "check_entailment"
    ]
  },
  "translation": {
    "default_provider": "mock",
    "max_input_chars": 500,
    "cache_max_entries": 1024,
    "cache_ttl_seconds": 86400,
    "min_confidence": 0.5,
    "lang_codes": { "or": "ory_Odia", "en": "eng_Latn" }
  },
  "retrieval": {
    "default_provider": "local_hybrid",
    "top_k": 4,
    "per_ranker_top": 8,
    "min_score": 0.05,
    "glossary_expansion": true,
    "rrf_k": 60
  },
  "generation": {
    "default_provider": "mock",
    "max_answer_chars": 1200,
    "require_citation": true
  },
  "validation": {
    "min_odia_unicode_ratio": 0.6,
    "max_answer_chars": 1200,
    "max_keyword_overlap_to_claim_grounding": 0.85,
    "safety_blocked_terms": [],
    "grounding": "entailment_provider_or_extractive"
  }
}
