 """Pydantic v2 schemas — single source of truth for SAARTHI contracts.
 
+Aligned with Design Document v2 (Sections 6-9, Appendix A):
+- Event types are the frozen v2 enum (SESSION_STARTED ... NETWORK_STATE_CHANGED).
+- Mastery is an integer in basis points (p_bp, 0..10000).
+- Sync returns exactly one of ACCEPTED / DUPLICATE / RETRYABLE / REJECTED
+  per event, with a stable reason and effect.
+- Decisions carry needs_help; decisions/traces carry source (server|local).
+- Device auth uses non-extractable ECDSA P-256 device keys with short-lived
+  access tokens and rotating refresh tokens.
+
 OpenAPI is generated from these models by FastAPI automatically. The
-TypeScript contracts in `frontend/src/generated/api.ts` are produced from
-the OpenAPI schema by `scripts/gen_types.py`.
+TypeScript contracts in `frontend/src/generated/api.ts` mirror these models.
 """
 from __future__ import annotations
 
-import hashlib
 import time
-import unicodedata
 import uuid
 from datetime import datetime, timezone
 from enum import Enum
